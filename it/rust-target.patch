@@ -0,0 +1,117 @@
+package dev.seatlock.it;
+
+import dev.seatlock.config.ReservationProperties;
+import dev.seatlock.idempotency.IdempotencyCleanupJob;
+import dev.seatlock.idempotency.IdempotencyStore;
+import dev.seatlock.repository.BookingRepository;
+import dev.seatlock.repository.EventRepository;
+import dev.seatlock.repository.HoldRepository;
+import dev.seatlock.repository.SeatRepository;
+import dev.seatlock.service.HoldExpiryJob;
+import dev.seatlock.service.ReservationMetrics;
+import dev.seatlock.service.ReservationService;
+import dev.seatlock.support.RustTarget;
+import java.net.URLEncoder;
+import java.nio.charset.StandardCharsets;
+import java.time.Clock;
+import java.time.Instant;
+import java.util.UUID;
+import org.springframework.boot.autoconfigure.condition.ConditionalOnProperty;
+import org.springframework.boot.test.context.TestConfiguration;
+import org.springframework.context.annotation.Bean;
+import org.springframework.context.annotation.Primary;
+import org.springframework.orm.ObjectOptimisticLockingFailureException;
+import org.springframework.transaction.PlatformTransactionManager;
+
+/**
+ * With {@code -Dseatlock.target=rust}, the beans the tests call directly run their work in the
+ * Rust service through its test hooks instead of in the in-process Java service.
+ */
+@TestConfiguration(proxyBeanMethods = false)
+@ConditionalOnProperty(name = "seatlock.target", havingValue = "rust")
+class RustTargetBeans {
+
+  @Bean
+  @Primary
+  HoldExpiryJob remoteHoldExpiryJob(
+      ReservationService reservations,
+      ReservationProperties properties,
+      ReservationMetrics metrics,
+      Clock clock) {
+    return new RemoteHoldExpiryJob(reservations, properties, metrics, clock);
+  }
+
+  @Bean
+  @Primary
+  IdempotencyCleanupJob remoteCleanupJob(
+      IdempotencyStore store, ReservationProperties properties, Clock clock) {
+    return new RemoteCleanupJob(store, properties, clock);
+  }
+
+  @Bean
+  @Primary
+  ReservationService remoteReservationService(
+      EventRepository events,
+      SeatRepository seats,
+      HoldRepository holds,
+      BookingRepository bookings,
+      ReservationProperties properties,
+      ReservationMetrics metrics,
+      Clock clock,
+      PlatformTransactionManager transactionManager) {
+    return new RemoteReservationService(
+        events, seats, holds, bookings, properties, metrics, clock, transactionManager);
+  }
+
+  public static class RemoteHoldExpiryJob extends HoldExpiryJob {
+    RemoteHoldExpiryJob(
+        ReservationService r, ReservationProperties p, ReservationMetrics m, Clock c) {
+      super(r, p, m, c);
+    }
+
+    @Override
+    public int sweep() {
+      return RustTarget.post("/__test/jobs/expire", "{}").get("expired").asInt();
+    }
+  }
+
+  public static class RemoteCleanupJob extends IdempotencyCleanupJob {
+    RemoteCleanupJob(IdempotencyStore s, ReservationProperties p, Clock c) {
+      super(s, p, c);
+    }
+
+    @Override
+    public void purgeExpired() {
+      RustTarget.post("/__test/jobs/idempotency-cleanup", "{}");
+    }
+  }
+
+  public static class RemoteReservationService extends ReservationService {
+    RemoteReservationService(
+        EventRepository events,
+        SeatRepository seats,
+        HoldRepository holds,
+        BookingRepository bookings,
+        ReservationProperties properties,
+        ReservationMetrics metrics,
+        Clock clock,
+        PlatformTransactionManager transactionManager) {
+      super(events, seats, holds, bookings, properties, metrics, clock, transactionManager);
+    }
+
+    /** Same contract as the Java method: true = expired, false = nothing to do, throws on a lost race. */
+    @Override
+    public boolean expireHold(UUID holdId, Instant now) {
+      String at = URLEncoder.encode(now.toString(), StandardCharsets.UTF_8);
+      String result =
+          RustTarget.post("/__test/holds/" + holdId + "/expire?at=" + at, "{}")
+              .get("result")
+              .asText();
+      return switch (result) {
+        case "expired" -> true;
+        case "not-active" -> false;
+        default -> throw new ObjectOptimisticLockingFailureException("Hold", holdId);
+      };
+    }
+  }
+}
