+  }
+
   @AfterEach
   void stopTime() {
+    if (RustTarget.enabled()) {
+      RustTarget.scheduling(false, 200);
+    }
     clock.set(Instant.now()); // do not leave this context's sweeper running ahead of real time
   }
 
