@@ -0,0 +1,69 @@
+package dev.seatlock.support;
+
+import com.fasterxml.jackson.databind.JsonNode;
+import com.fasterxml.jackson.databind.ObjectMapper;
+import java.io.IOException;
+import java.net.URI;
+import java.net.http.HttpClient;
+import java.net.http.HttpRequest;
+import java.net.http.HttpResponse;
+import java.time.Instant;
+
+/**
+ * Points the integration tests at an external service (the Rust port) instead of the in-process
+ * Spring application. Enabled with {@code -Dseatlock.target=rust}; everything else is unchanged.
+ *
+ * <p>The tests still boot the Java context (for {@code JdbcTemplate} and the beans they autowire),
+ * but HTTP goes to {@code seatlock.baseUrl}, and the few white-box calls (move the clock, run a
+ * job now) are forwarded to the service's test-only {@code /__test} hooks.
+ */
+public final class RustTarget {
+
+  private static final HttpClient HTTP = HttpClient.newHttpClient();
+  private static final ObjectMapper JSON = new ObjectMapper();
+
+  private RustTarget() {}
+
+  public static boolean enabled() {
+    return "rust".equals(System.getProperty("seatlock.target"));
+  }
+
+  public static String baseUrl() {
+    return System.getProperty("seatlock.baseUrl", "http://localhost:8092");
+  }
+
+  public static String jdbcUrl() {
+    return System.getProperty("seatlock.jdbcUrl", "jdbc:postgresql://localhost:5433/seats_it");
+  }
+
+  /** Mirrors {@code MutableClock} into the service's clock. */
+  public static void setClock(Instant now) {
+    post("/__test/clock", "{\"instant\":\"" + now + "\"}");
+  }
+
+  /** Runtime equivalent of seats.scheduling.enabled / seats.expiry-sweep-interval. */
+  public static void scheduling(boolean enabled, long intervalMillis) {
+    post("/__test/scheduling", "{\"enabled\":" + enabled + ",\"intervalMillis\":" + intervalMillis + "}");
+  }
+
+  public static JsonNode post(String path, String body) {
+    try {
+      HttpResponse<String> r =
+          HTTP.send(
+              HttpRequest.newBuilder(URI.create(baseUrl() + path))
+                  .header("Content-Type", "application/json")
+                  .POST(HttpRequest.BodyPublishers.ofString(body))
+                  .build(),
+              HttpResponse.BodyHandlers.ofString());
+      if (r.statusCode() >= 300) {
+        throw new IllegalStateException(path + " -> " + r.statusCode() + " " + r.body());
+      }
+      return JSON.readTree(r.body());
+    } catch (IOException e) {
+      throw new IllegalStateException("test hook " + path + " failed", e);
+    } catch (InterruptedException e) {
+      Thread.currentThread().interrupt();
+      throw new IllegalStateException(e);
+    }
+  }
+}
